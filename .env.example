# Copie para .env e preencha. O .env NÃO vai para o Git.
# Gere o segredo com:  python -c "import secrets; print(secrets.token_hex(32))"

# ---------------------------------------------------------------- identidade
ORG_NOME=Portal de Cotações
ORG_SUBTITULO=Compras e Almoxarifado
ORG_DOMINIO=exemplo.com.br

# ---------------------------------------------------------------- obrigatório em produção
AMBIENTE=producao
APP_SECRET=troque-isto-por-um-token-de-64-hex

# ---------------------------------------------------------------- banco
# No Docker o valor certo é /dados/cotacoes.db (já definido no compose).
DB_PATH=/dados/cotacoes.db

# ---------------------------------------------------------------- sessão
SESSAO_HORAS=8
COOKIE_SECURE=1          # 1 exige HTTPS. Só use 0 em teste sem TLS.
COOKIE_SAMESITE=Lax
SENHA_MIN=10

# ---------------------------------------------------------------- e-mail das cotações
# DRY_RUN=1 simula o envio e registra tudo, sem tocar no SMTP. Comece assim.
DRY_RUN=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=cotacoes@exemplo.com.br

# ---------------------------------------------------------------- limites (por IP / 5 min)
LIMITE_LOGIN=15
LIMITE_ENVIO=10

# ---------------------------------------------------------------- multi-tenant
# 0 = instalação única. Ver MULTI_TENANT.md antes de ligar.
MULTI_TENANT=0
TENANT_PADRAO=1

# ---------------------------------------------------------------- Entra ID (opcional)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
